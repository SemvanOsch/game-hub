{
  "name": "game-hub",
  "version": "1.3.0",
  "description": "Game Hub — a desktop multiplayer game hub built with React, TypeScript and Electron. Games: Yahtzee, Battleships and Blackjack.",
  "author": "",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "concurrently -n server,app -c cyan,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "electron-vite dev",
    "dev:server": "cross-env tsx watch server/src/index.ts",
    "start:server": "cross-env tsx server/src/index.ts",
    "build": "npm run typecheck && electron-vite build",
    "build:app": "npm run build && electron-builder",
    "build:icon": "node scripts/generate-icon.mjs build/icon-source.webp",
    "preview": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:server",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cross-env": "^7.0.3",
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.1",
    "ws": "^8.18.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  },
  "build": {
    "appId": "com.example.gamehub",
    "productName": "Game Hub",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "SemvanOsch",
        "repo": "game-hub"
      }
    ],
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Game Hub",
      "artifactName": "GameHub-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Game"
    }
  }
}
