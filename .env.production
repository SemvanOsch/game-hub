# Baked into the packaged app at BUILD time (npm run build:app).
# Point this at your PUBLIC, deployed multiplayer server.
# Use wss:// (secure WebSocket) — hosting platforms terminate TLS at the domain.
# Once set, whoever installs the built app connects here automatically — no
# per-machine .env editing required.
VITE_MULTIPLAYER_SERVER_URL=wss://your-server-domain.example.com
